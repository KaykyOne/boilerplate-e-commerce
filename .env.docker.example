# Public addresses used from the browser. Do not add trailing slashes.
PUBLIC_ORIGIN=https://vps57731.publiccloud.com.br
STOREFRONT_URL=https://vps57731.publiccloud.com.br/test
# Absolute base URL for files served from apps/storefront/public.
# Do not add a trailing slash.
ASSET_BASE_URL=https://vps57731.publiccloud.com.br/test
API_URL=https://vps57731.publiccloud.com.br/test/api
PUBLIC_BASE_PATH=/test

STOREFRONT_PORT=6868
BACKEND_PORT=6969

# Heap available while compiling the Medusa Admin inside the backend image.
NODE_MAX_OLD_SPACE_SIZE=1536

ADMIN_PATH=/test/adm

# Database. Use a URL-safe password because it is inserted in DATABASE_URL.
POSTGRES_USER=medusa
POSTGRES_PASSWORD=replace_with_a_url_safe_password
POSTGRES_DB=medusa

# Generate independent random values before deploying.
JWT_SECRET=replace_with_a_long_random_value
COOKIE_SECRET=replace_with_another_long_random_value

# Stripe. Never expose either value in the storefront or commit real keys.
# Use sk_test_... / whsec_... for tests and sk_live_... / whsec_... in production.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Create this key in Medusa Admin, then recreate the storefront container.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
NEXT_PUBLIC_DEFAULT_REGION=gb
